# Copy to .env and fill in. Generate keys in Tenable VM: Settings > My Account > API Keys.
TIO_ACCESS_KEY=
TIO_SECRET_KEY=
# Optional: override the API host (default https://cloud.tenable.com)
# TIO_URL=https://cloud.tenable.com

# Optional: AKiPS (read-only API user) for hardware model/serial inventory
# AKIPS_URL=https://akips.example.edu
# AKIPS_USER=api-ro
# AKIPS_PASSWORD=
# AKIPS_CA_BUNDLE=/path/to/internal-ca.pem

# Optional: Cisco Support APIs (EoX + Serial Number to Information)
# CISCO_CLIENT_ID=
# CISCO_CLIENT_SECRET=
# CISCO_TOKEN_URL=https://id.cisco.com/oauth2/default/v1/token
# CISCO_API_BASE=https://apix.cisco.com
